<style>
  .ft { border-top: 1px solid var(--line); padding-block: 40px; }
  .ft-inner { display: flex; align-items: center; gap: 24px; flex-wrap: wrap; }
  .ft-logo { font-family: var(--font-display); font-weight: 600; }
  .ft-logo span { color: var(--accent); }
  .ft-links { display: flex; gap: 22px; }
  .ft-links a { font-size: var(--step--1); color: var(--ink-mid); }
  .ft-links a:hover { color: var(--ink); }
  .ft-copy { font-size: var(--step--1); color: var(--ink-faint); margin-left: auto; }
  .ft-mail { font-size: var(--step--1); color: var(--ink-mid); }
</style>
