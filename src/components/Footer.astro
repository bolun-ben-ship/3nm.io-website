<footer class="ft">
  <div class="wrap ft-inner">
    <a href="/" class="ft-logo">RightClick<span>:AI</span></a>
    <nav class="ft-links">
      <a href="/about">About</a>
      <a href="/how-it-works">How it works</a>
      <a href="/case-studies">My work</a>
      <a href="/faq">FAQ</a>
