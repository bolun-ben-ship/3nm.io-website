---
/* Section 1 — Hero.  Slots S1.1–S1.6.  Motion: ANIMATION-SPEC §1.
   Placeholder for the licensed .lottie, rebuilt to match zig's choreography (verified frame-by-frame
   from references/zig ai analysis/lottie): an off-screen-right WHEEL whose radial arms carry the cards.
   4 scenes + two 1s holds, seamless loop — driven by motion.js → initHeroLoop (NOT a plain loop). */
/* Copy: content/index.md §1 — the "chaos-stage" notification pile, verbatim.
   Card shape (1-line title + 1-line sub) is fixed by the merge choreography, so the app line is the
   title and the message is the sub (visually ellipsized). */
const tasks = [
  { icon: 'chat',  tone: 'purple', time: '2m ago',     title: 'Slack · Sarah',      sub: '@you can you approve the Q3 forecast deck before 3pm?' },
  { icon: 'mail',  tone: 'blue',   time: 'Tue, 3 days', title: 'Email · Compliance', sub: 'Re: Trade authorisation — awaiting your sign-off.' },
  { icon: 'alert', tone: 'coral',  time: 'Just now',    title: 'Alert · Invoicing',  sub: 'Invoice overdue. SGD 8,400 · 14 days late.' },
  { icon: 'cal',   tone: 'slate',  time: 'In 12 min',   title: 'Calendar',           sub: 'Forecast review · prep needed before call' },
];
const trust = ['You own the code', 'Live in weeks, not quarters', 'Stop anytime', 'Built in Singapore'];
---
<section class="hero" id="top">
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <p class="eyebrow reveal" data-r="1">For founder-run Singapore service firms · 5–35 staff</p> <!-- S1.1 -->
      <h1 class="hero-h1 reveal" data-r="2">You're the system<br />holding it all together.<br /><span class="accent">That's the problem.</span></h1> <!-- S1.2 -->
      <p class="hero-sub reveal" data-r="3">You don't have to be. I build you one system to see and run your whole business, the custom internal software off-the-shelf SaaS won't. It stops running through you, so you can <strong>scale without the next hire</strong>. You own every line.</p> <!-- S1.3 -->
      <div class="hero-cta reveal" data-r="4">
        <a href="#closing" class="btn btn-primary">Book a free 30-min call <span class="arrow">→</span></a> <!-- S1.4 -->
        <a href="/how-it-works" class="btn btn-ghost">See how it works</a>                       <!-- S1.5 -->
      </div>
      <ul class="hero-trust reveal" data-r="5">
        {trust.map((t) => (<li>{t}</li>))}
      </ul>
    </div>

    <!-- S1.6 hero illustration — off-screen wheel + radial-arm cards (placeholder .lottie stand-in) -->
    <div class="hero-illus" data-hero role="img" aria-label="An ordinary morning of interrupts addressed to the founder">
      <svg class="hero-wheel-arc" viewBox="0 0 600 560" preserveAspectRatio="none" aria-hidden="true">
        <g fill="none" stroke="var(--hair)" stroke-width="1">
          <circle data-arc cx="600" cy="280" r="300"/>
          <circle data-arc cx="600" cy="280" r="430"/>
          <circle data-arc cx="600" cy="280" r="540"/>
        </g>
      </svg>
      <svg class="hero-arms" aria-hidden="true"></svg>

      {tasks.map((t, i) => (
        <article class={`hx-card tcard tone-${t.tone}`} data-card={i} data-role="task">
          <span class="hx-time">{t.time}</span>
          <div class="hx-row">
            <span class={`hx-icon ic-${t.icon}`} aria-hidden="true"></span>
            <div class="hx-txt"><p class="hx-title">{t.title}</p><p class="hx-sub">{t.sub}</p></div>
            <span class="hx-unread" aria-hidden="true"></span>
          </div>
        </article>
      ))}

      <article class="hx-card wecard" data-card="4" data-role="we">
        <div class="hx-row">
          <span class="hx-brand" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 32 32" fill="none"><path d="M6 3L24 16.5L17 19.4L13.6 28L6 3Z" fill="currentColor"/></svg>
          </span>
          <p class="hx-title">The system did</p>
        </div>
        <div class="hx-foot">
          <span class="hx-check sm" aria-hidden="true">✓</span><span class="hx-meta">Status, reports, follow-ups</span>
        </div>
      </article>

      <article class="hx-card youcard" data-card="5" data-role="you">
        <div class="hx-row">
          <span class="hx-photo" aria-hidden="true"></span>
          <p class="hx-title">You did</p>
        </div>
        <div class="hx-foot"><span class="hx-check sm" aria-hidden="true">✓</span><span class="hx-meta">Made the one call that mattered</span></div>
      </article>
    </div>
  </div>
</section>

<style>
  .hero { padding-top: clamp(104px, 13vw, 168px); padding-bottom: var(--section-y); }
  .hero-grid { display: grid; grid-template-columns: 1.15fr 0.85fr; gap: clamp(32px, 5vw, 72px); align-items: center; }

  /* Real H1 is 3 lines / 47 chars (vs the placeholder's 2 short lines), so it needs a slightly
     tighter cap + wider measure than --title-xl, or the forced breaks wrap into six lines. */
  .hero-h1 { font-size: clamp(2.1rem, 1rem + 3.3vw, 3.15rem); font-weight: 500; margin: 26px 0 26px; max-width: 26ch; letter-spacing: -0.035em; }
  .hero-sub { font-size: clamp(1.15rem, 1rem + 0.7vw, 1.375rem); line-height: 1.5; color: var(--ink-mid); max-width: 42ch; }
  .hero-sub strong { font-weight: 700; color: var(--ink); }
  .hero-cta { display: flex; gap: 14px; flex-wrap: wrap; margin-top: 40px; }
  .hero-cta .btn { font-size: 1.05rem; padding: 1.05em 1.9em; }

  /* trust row (content §1, 4 items with accent dots) */
  .hero-trust { display: flex; flex-wrap: wrap; gap: 10px 26px; margin-top: 30px; padding: 0; }
  .hero-trust li { display: inline-flex; align-items: center; gap: 8px; font-size: var(--text-s); color: var(--ink-muted); }
  .hero-trust li::before { content: ''; width: 5px; height: 5px; border-radius: 50%; background: var(--green); }

  /* — illustration stage: overflow clips the off-screen wheel to an arc;
       a soft left-edge mask dissolves anything at the clip line so there's no hard shadow seam — */
  .hero-illus { position: relative; height: 640px; overflow: hidden;
    -webkit-mask-image: linear-gradient(to right, transparent 0, #000 36px);
    mask-image: linear-gradient(to right, transparent 0, #000 36px); }
  html.no-js .hero-illus, .hero-illus.is-static { -webkit-mask-image: none; mask-image: none; }
  .hero-wheel-arc { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0.7; }
  .hero-arms { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; pointer-events: none; }
  .hero-arms :global(line) { stroke: var(--hair); stroke-width: 1; }

  .hx-card { position: absolute; top: 0; left: 0; width: 310px; background: var(--paper); border: 1px solid var(--hair);
    border-radius: var(--r-lg); padding: 16px 18px; box-shadow: 0 20px 50px -22px rgba(10,18,12,0.24);
    transform: translate(-9999px, 0); will-change: transform, opacity; }
  .hx-time { font-family: var(--font-mono); font-size: 0.74rem; font-weight: 600; letter-spacing: 0.03em; }
  .tone-slate  .hx-time { color: #5b6b78; }        .tone-slate  .hx-icon { background: #e9edf0; color: #5b6b78; }
  .tone-blue   .hx-time { color: #3f7fb0; }        .tone-blue   .hx-icon { background: #e6eff6; color: #3f7fb0; }
  .tone-coral  .hx-time { color: var(--coral); }  .tone-coral  .hx-icon { background: var(--coral-tint); color: var(--coral); }
  .tone-purple .hx-time { color: #8a52c4; }        .tone-purple .hx-icon { background: #f0e9f8; color: #8a52c4; }

  .hx-row { display: flex; align-items: center; gap: 12px; margin-top: 8px; }
  .hx-icon { flex: none; width: 36px; height: 36px; border-radius: 9px; display: grid; place-items: center; }
  .hx-icon::after { content: ''; width: 18px; height: 18px; background: currentColor; -webkit-mask: var(--ic) center/contain no-repeat; mask: var(--ic) center/contain no-repeat; }
  .ic-chat  { --ic: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="black" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a8 8 0 0 1-8 8H7l-4 3v-6.5A8 8 0 0 1 11 4h2a8 8 0 0 1 8 8z"/></svg>'); }
  .ic-alert { --ic: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="black" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 2 20h20L12 3z"/><path d="M12 10v4M12 17.2v.1"/></svg>'); }
  .ic-mail  { --ic: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="black" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/></svg>'); }
  .ic-cal   { --ic: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="black" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>'); }
  .hx-txt { min-width: 0; }
  .hx-title { font-family: var(--font-display); font-weight: 600; font-size: 1.02rem; line-height: 1.15; color: var(--ink); }
  .hx-sub { font-size: 0.8rem; color: var(--ink-muted); margin-top: 2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 186px; } /* 1 line → all task cards equal height → 100% overlap on merge */
  .hx-check { margin-left: auto; flex: none; width: 25px; height: 25px; border-radius: 50%; background: var(--green); color: #fff; font-size: 12px; display: grid; place-items: center; }
  /* unread marker — these are interrupts waiting on the founder, not completed work */
  .hx-unread { margin-left: auto; flex: none; width: 9px; height: 9px; border-radius: 50%; background: currentColor; }
  .tone-slate  .hx-unread { color: #5b6b78; }
  .tone-blue   .hx-unread { color: #3f7fb0; }
  .tone-coral  .hx-unread { color: var(--coral); }
  .tone-purple .hx-unread { color: #8a52c4; }

  /* summary cards */
  .hx-brand { flex: none; width: 36px; height: 36px; border-radius: 9px; background: var(--green); color: #fff; display: grid; place-items: center; }
  .youcard .hx-photo { flex: none; width: 36px; height: 36px; border-radius: 9px; background: linear-gradient(135deg,#2a2f33,#454e4c); }
  .wecard .hx-title, .youcard .hx-title { font-size: 1.12rem; }
  .hx-foot { display: flex; align-items: center; gap: 8px; margin-top: 13px; }
  .hx-check.sm { width: 17px; height: 17px; font-size: 9px; }
  .hx-meta { font-size: 0.82rem; color: var(--ink-muted); }

  /* no-JS + small-screen fallback = a clean stacked list of the 4 task cards (motion.js adds .is-static ≤767) */
  html.no-js .hx-card,
  .hero-illus.is-static .hx-card { position: static; transform: none !important; opacity: 1 !important; display: block; width: auto; max-width: 340px; margin: 0 auto 12px; }
  html.no-js .wecard, html.no-js .youcard,
  .hero-illus.is-static .wecard, .hero-illus.is-static .youcard { display: none; }
  .hero-illus.is-static { height: auto; overflow: visible; }
  .hero-illus.is-static .hero-arms, .hero-illus.is-static .hero-wheel-arc { display: none; }
  @media (prefers-reduced-motion: reduce) {
    html.js .hero-arms, html.js .hero-wheel-arc { opacity: 0.5; }
  }

  @media (max-width: 900px) {
    .hero-grid { grid-template-columns: 1fr; }
    .hero-illus { height: 540px; margin-top: 8px; }
  }
  @media (max-width: 480px) { .hero-illus { height: 480px; } .hx-card { width: 288px; } }
</style>
