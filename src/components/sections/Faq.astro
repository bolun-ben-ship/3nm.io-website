---
/* Section 11 — FAQ accordion.  Slots S11.1–S11.4.  Motion: ANIMATION-SPEC §11 (interactive expand/collapse). */
/* content/index.md §11 — verbatim, 7 of the 11 (the rest live on /faq via the see-all link). */
const faqs = [                                                          /* ×7 */
  { q: 'What happens after I book a call?', a: 'Free 30-minute call, then a paid audit if we both see a fit. The audit maps your workflow and data, and becomes the scope. <strong>You approve the plan and quote before I build.</strong> Then I build on your real data, in phases, and you own each one as it ships.' },
  { q: 'What do you actually build?', a: 'Custom internal software built to your workflow: BI dashboards, admin automation, and internal apps no SaaS sells you. Plus hosting, auth, database, and the data connections we agree in scoping. Scoped to your business, never a fixed package.' },
  { q: 'Who builds it?', a: 'Ben builds it. No subcontractors, no outsourcing, no handoffs. You work directly with the same person from discovery call to deployment.' },
  { q: 'What if Ben misses a deadline?', a: 'I don&rsquo;t sell a deadline. I build until it&rsquo;s live and doing the job. You get a system that works. <strong>What I need back:</strong> fast feedback. Every blocked decision compounds, so I move fast and need you to move with me.' },
  { q: 'Do I own the code?', a: 'Completely. Every line of code, every database, the infrastructure, the SOPs, the knowledge wiki: everything becomes your sole property on delivery. Ben retains no license or rights. If we ever part ways, the system continues to work as intended.' },
  { q: 'What does it cost?', a: '<strong>Every build is scoped and quoted after the audit</strong> — no fixed price, no package. The discovery call is free. The audit is paid: <strong>SGD 635</strong> for a sample dashboard, or <strong>SGD 865</strong> for a working custom workflow. Whatever it produces is yours to keep. You approve the quote before I build.' },
  { q: 'Do you work with PSG or EDG grants?', a: 'No. A grant route adds 3 to 6 months of approval before a line of code is written, and freezes your scope during the wait. The founders I build for pay from cashflow because they want it live fast. <strong>If grant recovery is your priority, I&rsquo;m not your fit.</strong>' },
];
---
<section class="section faq" id="faq">
  <div class="wrap faq-wrap">
    <header class="faq-head">
      <h2 class="faq-h2 reveal">Questions founders actually ask.</h2>   <!-- S11.1 -->
      <p class="faq-sub reveal">If something isn't here, email <a href="mailto:ben@3nm.io">ben@3nm.io</a>. Reply within 24 hours.</p> <!-- S11.2 -->
    </header>

    <div class="faq-list">
      {faqs.map((f, i) => (
        <div class="faq-item">
          <button class="faq-q" aria-expanded="false" aria-controls={`faq-a-${i}`} id={`faq-q-${i}`}>
            <span>{f.q}</span>
            <span class="faq-icon" aria-hidden="true"></span>
          </button>
          <div class="faq-a" id={`faq-a-${i}`} role="region" aria-labelledby={`faq-q-${i}`}>
            <p set:html={f.a}></p>
          </div>
        </div>
      ))}
    </div>

    <p class="faq-more reveal"><a href="/faq">See all questions <span class="arrow">→</span></a></p>
  </div>
</section>

<style>
  .faq-wrap { max-width: 820px; }
  .faq-head { text-align: center; margin-bottom: clamp(32px, 5vw, 56px); }
  .faq-h2 { font-size: var(--title-m); }
  .faq-sub { font-size: var(--text-l); color: var(--ink-muted); margin-top: 10px; }
  .faq-sub a { color: var(--green); }
  .faq-more { text-align: center; margin-top: 32px; }
  .faq-more a { font-family: var(--font-display); font-weight: 500; font-size: var(--text-s); color: var(--green); display: inline-flex; align-items: center; gap: 6px; }
  .faq-more .arrow { transition: transform var(--dur) var(--ease-quint); }
  .faq-more a:hover .arrow { transform: translateX(3px); }
  .faq-a p :global(strong) { color: var(--ink); font-weight: 700; }

  .faq-item { border-top: 1px solid var(--hair); }
  .faq-item:last-child { border-bottom: 1px solid var(--hair); }
  .faq-q { width: 100%; display: flex; align-items: center; gap: 20px; justify-content: space-between; padding: 24px 4px; background: none; border: 0; cursor: pointer; text-align: left; font-family: var(--font-display); font-weight: 500; font-size: var(--text-l); color: var(--ink); }
  .faq-icon { position: relative; flex: none; width: 18px; height: 18px; }
  .faq-icon::before, .faq-icon::after { content: ''; position: absolute; top: 50%; left: 0; width: 18px; height: 1.6px; background: var(--ink); transition: transform 260ms var(--ease-quint); }
  .faq-icon::after { transform: rotate(90deg); }
  .faq-item.open .faq-icon::after { transform: rotate(0); }
  .faq-item.open .faq-q { color: var(--green); }

  .faq-a { overflow: hidden; height: 0; transition: height 320ms var(--ease-quint); }
  .faq-a p { padding: 0 44px 26px 4px; color: var(--ink-mid); font-size: var(--text-m); line-height: 1.55; }
  html.no-js .faq-a { height: auto; }
</style>
