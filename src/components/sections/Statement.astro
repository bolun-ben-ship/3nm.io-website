---
/* Section 3 — Statement + integration marquee.  Slots S3.1–S3.3.  Motion: ANIMATION-SPEC §3 (word-reveal + logo marquee).
   Logo bar mirrors zig.ai: a static label + divider on the left, logos scroll right and fade in from behind it. */
const logos = ['hubspot', 'notion', 'airtable', 'asana', 'clickup', 'googlesheets', 'quickbooks', 'xero', 'trello', 'zapier']; /* S3.3 */
---
<section class="section statement" id="statement">
  <div class="wrap st-top">
    <p class="eyebrow reveal">It starts with your data.</p>              <!-- S3 eyebrow -->
    <h2 class="st-h2 animate-text_opacity">One view across <span class="accent">the tools your data already lives in.</span></h2> <!-- S3.1 -->
  </div>

  <div class="wrap st-trust">
    <span class="st-tb">Works with</span>                                 <!-- S3.2 (was "Trusted by") -->
    <span class="st-div" aria-hidden="true"></span>
    <div class="st-marquee" data-marquee aria-label="Integrations">
      <div class="marquee-track">
        {logos.concat(logos).map((l) => (
          <img src={`/assets/logos/${l}.svg`} alt="" class="st-logo" loading="lazy" />
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .st-top { text-align: center; max-width: 42rem; margin-inline: auto; }
  .st-h2 { font-size: var(--title-l); font-weight: 500; margin-top: 16px; letter-spacing: -0.03em; text-wrap: balance; }

  .st-trust { display: flex; align-items: center; margin-top: clamp(48px, 7vw, 88px); }
  .st-tb { flex: none; font-family: var(--font-mono); font-size: 0.95rem; font-weight: 500; color: var(--ink-muted); white-space: nowrap; padding-right: 22px; }
  .st-div { flex: none; width: 1px; height: 34px; background: var(--line-2); margin-right: 26px; }

  .st-marquee { position: relative; flex: 1; min-width: 0; overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 6%, #000 92%, transparent);
    mask-image: linear-gradient(90deg, transparent 0, #000 6%, #000 92%, transparent); }
  .marquee-track { display: flex; align-items: center; gap: clamp(46px, 5vw, 84px); width: max-content; will-change: transform; }
  .st-logo { height: 30px; width: auto; flex: none; filter: grayscale(1) opacity(0.5); transition: filter var(--dur) var(--ease-quint); }
  .st-logo:hover { filter: grayscale(0) opacity(1); }

  @media (max-width: 767px) {
    .st-tb { font-size: 0.85rem; padding-right: 16px; }
    .st-div { margin-right: 18px; height: 28px; }
    .st-logo { height: 24px; }
  }
</style>
