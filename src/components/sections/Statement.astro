---
/* Section 3 — Statement + Trusted-by.  Slots S3.1–S3.3.  Motion: ANIMATION-SPEC §3 (word-reveal + logo marquee). */
const logos = ['Northwind', 'Selliora', 'Ketch', 'Velociti', 'Farmount', 'Cksium']; /* S3.3 ×6 placeholder wordmarks */
---
<section class="section statement" id="statement">
  <div class="wrap">
    <h2 class="st-h2 animate-text_opacity">We don't speed up the busywork. <span class="accent">We give your team a crew that runs it.</span></h2> <!-- S3.1 ≤66 -->
  </div>

  <div class="st-trusted">
    <p class="st-label">Trusted by</p>                                    <!-- S3.2 -->
    <div class="marquee" data-marquee>
      <div class="marquee-track">
        {logos.concat(logos).map((name) => (<span class="st-logo">{name}</span>))}
      </div>
    </div>
  </div>
</section>

<style>
  .st-h2 { font-size: var(--title-l); font-weight: 500; text-align: center; max-width: 20ch; margin-inline: auto; letter-spacing: -0.03em; }
  .st-trusted { margin-top: clamp(48px, 7vw, 88px); }
  .st-label { font-family: var(--font-mono); font-size: var(--text-s); letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-muted); text-align: center; margin-bottom: 22px; }

  .marquee { position: relative; overflow: hidden; -webkit-mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent); mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent); }
  .marquee-track { display: flex; gap: clamp(40px, 6vw, 80px); width: max-content; will-change: transform; }
  .st-logo { font-family: var(--font-display); font-weight: 600; font-size: 1.35rem; color: var(--ink-faint); letter-spacing: -0.02em; white-space: nowrap; }
</style>
