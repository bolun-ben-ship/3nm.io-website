---
import Eyebrow from '../Eyebrow.astro';
/* Section 12 — Closing CTA + Footer.  Motion: ANIMATION-SPEC §12 (word-reveal).
   Copy: content/index.md §12 (verbatim, incl. the Formspree form, note, error and success states)
   + content/_shell.md (footer). */
const footNav = [
  { href: '/about', label: 'About' },
  { href: '/how-it-works', label: 'How it works' },
  { href: '/case-studies', label: 'My work' },
  { href: '/faq', label: 'FAQ' },
];
---
<section class="flood-green footer-cta" id="closing">
  <div class="wrap fc-inner">
    <Eyebrow icon="arrow">Get started</Eyebrow>
    <h2 class="fc-h2 animate-text_opacity">Book a 30-minute call.<br />It's free.</h2> <!-- S12.1 -->
    <p class="fc-sub reveal">No pitch, no proposal. Book a call, or tell me the one thing eating your week and I'll say if it's worth one. I read every one myself, and take three projects a month.</p> <!-- S12.2 -->

    <form class="fc-form reveal" id="discovery-form" action="https://formspree.io/f/xzdyljay" method="POST" novalidate>
      <div class="fc-row">
        <label>Your name
          <input type="text" id="name" name="name" placeholder="Jane Smith" required autocomplete="name" />
        </label>
        <label>Work email
          <input type="email" id="email" name="email" placeholder="you@company.com" required autocomplete="email" />
        </label>
      </div>
      <label>Not ready to book? Tell me the one thing eating your week <span class="opt">(optional)</span>
        <textarea id="bottleneck" name="bottleneck" rows="2" placeholder="2 to 3 sentences is enough."></textarea>
      </label>
      <button type="submit" class="btn fc-submit">Book my free call <span class="arrow">→</span></button> <!-- S12.3 -->
      <p class="fc-note">ben@3nm.io · Singapore · No pitch, no proposal.</p>
      <p class="fc-error" hidden>Something went wrong. Email <a href="mailto:ben@3nm.io">ben@3nm.io</a> directly, or try again.</p>
    </form>

    <div class="fc-success" hidden aria-live="polite">
      <p class="fc-success-h">I'll be in touch shortly.</p>
      <p class="fc-success-sub">Expect an email from ben@3nm.io within 24 hours (SGT, UTC+8).</p>
    </div>
  </div>
</section>

<footer class="site-footer">
  <div class="wrap ft-inner">
    <div class="ft-brand">
      <a href="#top" class="ft-logo">RightClick<span>:AI</span></a>
      <a class="ft-mail" href="mailto:ben@3nm.io">ben@3nm.io</a>
    </div>
    <nav class="ft-nav" aria-label="Footer">
      {footNav.map((l) => (<a href={l.href}>{l.label}</a>))}    <!-- S12.5 -->
    </nav>
    <div class="ft-legal">
      <span class="ft-copy">© 2026 RightClick:AI. All rights reserved.</span> <!-- S12.6 -->
      <span class="ft-credit">Built in Singapore.</span>                      <!-- S12.7 -->
    </div>
  </div>
</footer>

<script>
  /* Formspree submit → success / error states (content §12). */
  const form = document.getElementById('discovery-form');
  const success = document.querySelector('.fc-success');
  const error = document.querySelector('.fc-error');
  if (form && success && error) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      error.setAttribute('hidden', '');
      const btn = form.querySelector('.fc-submit');
      btn.disabled = true;
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        if (!res.ok) throw new Error('bad status');
        form.setAttribute('hidden', '');
        success.removeAttribute('hidden');
      } catch {
        error.removeAttribute('hidden');
        btn.disabled = false;
      }
    });
  }
</script>

<style>
  .footer-cta { background: var(--green); }
  .fc-inner { text-align: center; padding-block: clamp(72px, 11vw, 150px); }
  .fc-h2 { font-size: var(--title-l); font-weight: 500; color: #fff; max-width: 16ch; margin: 14px auto 0; letter-spacing: -0.03em; }
  .fc-sub { font-size: var(--text-l); color: var(--on-flood-mut); margin: 18px auto 0; max-width: 54ch; }

  /* form on the green flood */
  .fc-form { display: flex; flex-direction: column; gap: 14px; max-width: 560px; margin: clamp(32px, 4vw, 48px) auto 0; text-align: left; }
  .fc-form label { display: flex; flex-direction: column; gap: 7px; font-family: var(--font-display); font-weight: 500; font-size: var(--text-s); color: var(--on-flood-mut); }
  .fc-row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .fc-form input, .fc-form textarea {
    font-family: var(--font-body); font-size: var(--text-m); color: #fff;
    padding: 13px 15px; border-radius: var(--r); border: 1px solid var(--line-flood);
    background: rgba(255,255,255,0.09);
  }
  .fc-form input::placeholder, .fc-form textarea::placeholder { color: rgba(255,255,255,0.45); }
  .fc-form input:focus, .fc-form textarea:focus { outline: none; border-color: #fff; background: rgba(255,255,255,0.14); }
  .opt { color: rgba(255,255,255,0.5); font-weight: 400; }
  .fc-submit { justify-content: center; background: #fff; color: var(--green); font-size: var(--text-m); padding: 1.05em 1.9em; margin-top: 4px; }
  .fc-submit:hover { background: rgba(255,255,255,0.88); }
  .fc-submit:disabled { opacity: 0.6; cursor: default; }
  .fc-note { text-align: center; font-size: var(--text-s); color: var(--on-flood-mut); }
  .fc-error { text-align: center; font-size: var(--text-s); color: #fff; }
  .fc-error a { text-decoration: underline; }

  .fc-success { max-width: 560px; margin: clamp(32px, 4vw, 48px) auto 0; }
  .fc-success-h { font-family: var(--font-display); font-weight: 600; font-size: var(--title-s); color: #fff; }
  .fc-success-sub { font-size: var(--text-m); color: var(--on-flood-mut); margin-top: 8px; }

  .site-footer { background: var(--dark); color: var(--on-dark); padding-block: clamp(40px, 6vw, 72px); }
  .ft-inner { display: grid; grid-template-columns: 1fr auto 1fr; gap: 32px; align-items: center; }
  .ft-brand { display: flex; flex-direction: column; gap: 10px; }
  .ft-logo { font-family: var(--font-display); font-weight: 600; font-size: 1.125rem; color: var(--on-dark); }
  .ft-logo span { color: var(--green-on-dark); }
  .ft-mail { font-size: var(--text-s); color: var(--on-dark-mut); }
  .ft-mail:hover { color: var(--on-dark); }
  .ft-nav { display: flex; gap: 22px; flex-wrap: wrap; justify-content: center; }
  .ft-nav a { font-size: var(--text-s); color: var(--on-dark-mut); }
  .ft-nav a:hover { color: var(--on-dark); }
  .ft-legal { display: flex; flex-direction: column; gap: 4px; text-align: right; }
  .ft-copy { font-size: var(--text-s); color: var(--on-dark-mut); }
  .ft-credit { font-size: var(--text-s); color: var(--on-dark-mut); opacity: 0.7; }

  @media (max-width: 767px) {
    .fc-row { grid-template-columns: 1fr; }
    .ft-inner { grid-template-columns: 1fr; text-align: center; }
    .ft-brand { align-items: center; }
    .ft-legal { text-align: center; }
  }
</style>
