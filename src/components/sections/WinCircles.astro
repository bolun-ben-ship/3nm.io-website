---
import Eyebrow from '../Eyebrow.astro';
/* Section 6+7 (merged) — Ops-hire trap: a green circle grows to fill the screen, then MORPHS into the Venn.
   content/index.md §5. Grow caption = the "most founders solve this by hiring" intro; Venn = hire-vs-build.
   Motion: motion.js → initWinMorph (pinned scroll-scrub). */
const leftTips = [                                                       /* S7.5 3 per circle, ≤66 */
  'Months of training before they run it, not you.',
  'They take leave. It all routes back to you.',
  'They quit. The SOPs leave in their head.',
];
const rightTips = [
  'Every line of code and your data, yours.',
  'Nothing leaves. Code, database, SOPs, all yours.',
  "Some founders didn't hire. They built it instead.",
];
---
<section class="wins-morph flood-dark" id="ops-trap" data-winmorph data-wins>
  <div class="wm-scroll">
    <div class="wm-pin">
      <!-- phase 1: the growing circle -->
      <div class="wm-grow" data-wm-grow aria-hidden="true"></div>
      <p class="wm-caption" data-wm-caption>So you hire. An admin. Then a GM. Then a head of ops. Here's what it hides.</p> <!-- §5 intro -->

      <!-- phase 2: the Venn it morphs into -->
      <div class="wm-venn" data-wm-venn>
        <header class="section-head wm-head">
          <Eyebrow icon="userplus">Before you write the job description</Eyebrow>    <!-- S7.1 -->
          <h2 class="wins-h2">An ops hire rents you a fix. <span class="accent">It never becomes yours.</span></h2> <!-- S7.2 -->
          <p class="wm-salary">An admin runs ~S$2,800 a month. An ops manager ~S$5,500. A GM ~S$11,000. Every month, forever.</p> <!-- salary anchor -->
        </header>

        <div class="win-circles-wrapp" data-venn>
          <div class="win-stage">
            <svg class="win-art" viewBox="0 0 760 560" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
              <circle class="win-circle is--left  illustration" cx="300" cy="280" r="180" data-venn-circle/>
              <circle class="win-circle is--right"              cx="460" cy="280" r="180" data-venn-circle/>
              <g class="win-mark"><path d="M366 262L392 282L382 285L378 300L366 262Z" fill="var(--green-on-dark)"/></g>
            </svg>

            <svg class="win-svg-overlay" viewBox="0 0 760 560" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
              <path d="M150 150 L173 153"   pathLength="1" stroke="var(--green-on-dark)"/>
              <path d="M120 280 L120 280.1" pathLength="1" stroke="var(--green-on-dark)"/>
              <path d="M150 410 L173 407"   pathLength="1" stroke="var(--green-on-dark)"/>
              <path d="M610 150 L587 153"   pathLength="1" stroke="#87bbd9"/>
              <path d="M640 280 L640 280.1" pathLength="1" stroke="#87bbd9"/>
              <path d="M610 410 L587 407"   pathLength="1" stroke="#87bbd9"/>
            </svg>

            <span class="win-label label-left">Hire the ops role</span>  <!-- S7.4 ×2 -->
            <span class="win-label label-right">Build the system instead</span>

            <div class="win-tooltips group-left">
              {leftTips.map((t) => (<span class="win-tooltip left">{t}</span>))}
            </div>
            <div class="win-tooltips group-right">
              {rightTips.map((t) => (<span class="win-tooltip right">{t}</span>))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="wrap wm-outro">
    <p class="wins-punch reveal"><span class="accent">Skip the ops hire.</span> Build a system you own.</p>
    <div class="wins-cta reveal">
      <a href="#closing" class="btn btn-primary">Book a free 30-min call <span class="arrow">→</span></a> <!-- S7.6 -->
      <a href="/how-it-works" class="btn btn-ghost">See how it works</a>                       <!-- S7.7 -->
    </div>
  </div>
</section>

<style>
  .wins-morph { background: var(--dark); position: relative; }
  .wm-scroll { height: 260vh; }                                  /* scroll room for the pinned morph */
  .wm-pin { position: sticky; top: 0; height: 100vh; overflow: hidden; display: grid; place-items: center; }

  /* growing circle */
  .wm-grow { position: absolute; top: 50%; left: 50%; width: 150vmax; height: 150vmax; margin: -75vmax 0 0 -75vmax;
    border-radius: 50%; background: var(--green); transform: scale(0.02); will-change: transform; }
  html.no-js .wm-grow, html.js .wm-grow { }
  .wm-caption { position: relative; z-index: 3; max-width: 20ch; text-align: center; padding-inline: var(--pad-x);
    font-family: var(--font-display); font-weight: 500; font-size: var(--title-s); line-height: 1.28; color: #fff; }

  /* the Venn scene (revealed after the fill) */
  .wm-venn { position: absolute; inset: 0; z-index: 2; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: clamp(12px, 2vh, 28px); padding: 88px var(--pad-x) 40px; opacity: 0; }
  html.no-js .wm-venn { opacity: 1; position: relative; }
  html.no-js .wm-grow, html.no-js .wm-caption { display: none; }
  .wm-head { max-width: 46rem; }
  .wins-h2 { font-size: var(--title-m); margin-top: 12px; }
  .wm-salary { font-family: var(--font-mono); font-size: var(--text-s); color: var(--on-dark-mut); margin-top: 12px; max-width: 56ch; margin-inline: auto; }

  .win-circles-wrapp { width: 100%; }
  .win-stage { position: relative; width: min(820px, 82vw); max-height: 60vh; aspect-ratio: 760 / 560; margin-inline: auto; }
  .win-art, .win-svg-overlay { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .win-circle { fill: transparent; stroke-width: 1.5; opacity: 0; }
  .win-circle.is--left  { stroke: var(--green-on-dark); }
  .win-circle.is--right { stroke: #87bbd9; }
  html.no-js .win-circle { opacity: 0.9; }

  .win-svg-overlay path { fill: none; stroke-width: 1; stroke-dasharray: 1; stroke-dashoffset: 1; }
  html.no-js .win-svg-overlay path { stroke-dashoffset: 0; }

  .win-label { position: absolute; top: 1%; font-family: var(--font-mono); font-size: var(--text-s); letter-spacing: 0.06em; color: var(--on-dark-mut); white-space: nowrap; }
  .label-left  { left: 4%; text-align: left; }
  .label-right { right: 4%; text-align: right; }

  .win-tooltips { position: absolute; inset: 0; pointer-events: none; }
  .win-tooltip { position: absolute; width: 174px; font-size: 0.8rem; line-height: 1.3; color: var(--on-dark); background: var(--dark-2); border: 1px solid var(--line-dark); border-radius: 10px; padding: 9px 11px; opacity: 0; transform: translateY(6px); transition: opacity 400ms var(--ease-quint), transform 400ms var(--ease-quint); }
  .win-tooltips.is-in .win-tooltip { opacity: 1; transform: none; }
  html.no-js .win-tooltip { opacity: 1; transform: none; }
  .group-left  .win-tooltip.left  { left: 0; text-align: left; }
  .group-left  .win-tooltip:nth-child(1) { top: 14%; }
  .group-left  .win-tooltip:nth-child(2) { top: 44%; }
  .group-left  .win-tooltip:nth-child(3) { top: 76%; }
  .group-right .win-tooltip.right { right: 0; text-align: left; }
  .group-right .win-tooltip:nth-child(1) { top: 14%; }
  .group-right .win-tooltip:nth-child(2) { top: 44%; }
  .group-right .win-tooltip:nth-child(3) { top: 76%; }

  .wm-outro { text-align: center; padding-block: clamp(48px, 8vw, 100px); }
  .wins-punch { font-family: var(--font-display); font-weight: 500; font-size: var(--title-s); line-height: 1.25; max-width: 24ch; margin: 0 auto; color: var(--on-dark); }
  .wins-cta { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; margin-top: clamp(24px, 4vw, 40px); }

  @media (max-width: 767px) {
    .wm-scroll { height: auto; }
    .wm-pin { position: static; height: auto; overflow: visible; padding-block: var(--section-y); }
    .wm-grow, .wm-caption { display: none; }
    .wm-venn { position: relative; opacity: 1; inset: auto; padding: 0; }
    .win-stage { max-height: none; width: 100%; aspect-ratio: auto; }
    .win-art, .win-svg-overlay, .win-label { display: none; }
    .win-tooltips { position: static; }
    .win-tooltip { position: static !important; width: auto; opacity: 1 !important; transform: none !important; margin-bottom: 10px; }
    .group-right { margin-top: 10px; }
  }
</style>
