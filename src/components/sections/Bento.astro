---
/* Section 4 — "Why different" bento.  Slots S4.1–S4.7.  Motion: ANIMATION-SPEC §4 (card scale-in + badge orbit). */
const cards = [
  { variant: '',      title: 'One motion, end to end',        body: 'From first touch to closed deal — research, outreach, meetings, follow-ups, and sync, all connected and talking to each other.', cta: false },
  { variant: 'red',   title: 'Built for the field, first',    body: 'Score a badge, a business card, or a handwritten name. Instantly enrich it, log it, and put the next move in your pocket before the room clears.', cta: false },
  { variant: 'green', title: 'Always working. Never waiting.', body: "It doesn't wait to be opened. It's a teammate that runs before the next call, between calls, and after the last one — automatically.", cta: false },
  { variant: '',      title: 'The rep stays in control',      body: 'Complete actions need approval. Simple ones just happen. Every action is visible, reversible, and one tap from undone.', cta: true },
  { variant: '',      title: 'Your agent on the phone',       body: 'Ask it anything mid-drive. "Send the follow-up. Log the call. Update the next step." It answers and does it — no laptop required.', cta: false },
  { variant: 'dark',  title: 'Intelligence trained on you',   body: 'Not generic AI. It reads your actual pipeline, your real signals, and gets sharper on your motion with every single week.', cta: false },
];
---
<section class="section bento" id="bento">
  <div class="wrap">
    <header class="section-head left">
      <p class="eyebrow reveal">Built different</p>                       <!-- S4.1 ≤18 -->
      <h2 class="bento-h2 animate-text_opacity">Why this beats everything you've tried</h2> <!-- S4.2 ≤54 -->
      <p class="bento-intro reveal">Most tools wait to be opened. This one is the teammate that never stops working.</p> <!-- S4.3 ≤82 -->
    </header>

    <div class="bento-grid">
      {cards.map((c, i) => (
        <article class={`bento-card b${i + 1} ${c.variant} ${c.variant === 'dark' ? 'on-dark' : ''} ${c.variant === 'green' || c.variant === 'red' ? 'on-flood' : ''} reveal-card`}>
          <span class="bento-idx">/ 0{i + 1}</span>                       <!-- S4.4 ×6 -->
          <div class="bento-body-wrap">
            <h3 class="bento-title">{c.title}</h3>                         <!-- S4.5 ×6 ≤34 -->
            <p class="bento-copy">{c.body}</p>                            <!-- S4.6 ×6 ≤200 -->
            {c.cta && <a href="#steps" class="bento-cta">Learn more <span class="arrow">→</span></a>} <!-- S4.7 -->
          </div>
          {c.variant === 'red' && (
            <div class="bento-phone" aria-hidden="true">
              <div class="phone">
                <span class="phone-badge" data-orbit>
                  <svg width="18" height="18" viewBox="0 0 32 32" fill="none"><path d="M6 3L24 16.5L17 19.4L13.6 28L6 3Z" fill="currentColor"/></svg>
                </span>
                <span class="phone-line w1"></span><span class="phone-line w2"></span><span class="phone-line w3"></span>
              </div>
            </div>
          )}
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .bento-h2 { font-size: var(--title-m); margin-top: 14px; max-width: 18ch; }
  .bento-intro { font-size: var(--text-xl); color: var(--ink-mid); margin-top: 16px; max-width: 40ch; }

  .bento-grid { display: grid; grid-template-columns: repeat(12, 1fr); gap: 16px; margin-top: clamp(40px, 6vw, 72px); grid-auto-rows: minmax(220px, auto); }
  .bento-card { position: relative; display: flex; flex-direction: column; justify-content: space-between; padding: 26px; border-radius: var(--r-lg); overflow: hidden; }
  .bento-card:not(.red):not(.green):not(.dark) { background: var(--sand); border: 1px solid var(--hair); }
  .bento-card.red   { background: var(--coral); }
  .bento-card.green { background: var(--green); }
  .bento-card.dark  { background: var(--dark); }

  /* asymmetric weave */
  .b1 { grid-column: span 5; } .b2 { grid-column: span 7; grid-row: span 1; min-height: 340px; }
  .b3 { grid-column: span 7; } .b4 { grid-column: span 5; }
  .b5 { grid-column: span 5; } .b6 { grid-column: span 7; }

  .bento-idx { font-family: var(--font-mono); font-size: var(--text-s); font-weight: 500; letter-spacing: 0.08em; color: var(--ink-muted); }
  .bento-card.red .bento-idx, .bento-card.green .bento-idx { color: var(--on-flood-mut); }
  .bento-card.dark .bento-idx { color: var(--green-on-dark); }
  .bento-title { font-size: var(--title-xs); margin-bottom: 10px; }
  .bento-copy { font-size: var(--text-m); line-height: 1.45; color: var(--ink-mid); max-width: 34ch; }
  .bento-card.red .bento-copy, .bento-card.green .bento-copy { color: var(--on-flood-mut); }
  .bento-card.dark .bento-copy { color: var(--on-dark-mut); }
  .bento-cta { display: inline-flex; align-items: center; gap: 6px; margin-top: 16px; font-family: var(--font-display); font-weight: 500; font-size: var(--text-s); color: var(--green); }
  .bento-cta .arrow { transition: transform var(--dur) var(--ease-quint); }
  .bento-cta:hover .arrow { transform: translateX(3px); }

  /* red-card phone mockup + orbiting brand badge */
  .bento-phone { position: absolute; right: 20px; bottom: -30px; }
  .phone { position: relative; width: 132px; height: 250px; border-radius: 22px; background: rgba(255,255,255,0.12); border: 1px solid rgba(255,255,255,0.28); backdrop-filter: blur(3px); padding: 20px 16px; }
  .phone-line { display: block; height: 9px; border-radius: 5px; background: rgba(255,255,255,0.35); margin-bottom: 12px; }
  .phone-line.w1 { width: 70%; } .phone-line.w2 { width: 90%; } .phone-line.w3 { width: 55%; }
  .phone-badge { position: absolute; top: -18px; left: -18px; width: 44px; height: 44px; border-radius: 50%; background: #fff; color: var(--coral); display: grid; place-items: center; box-shadow: 0 10px 26px -8px rgba(0,0,0,0.3); }

  .reveal-card { opacity: 0; transform: translateY(28px) scale(0.97); }
  html.no-js .reveal-card { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) { .reveal-card { opacity: 1; transform: none; } }

  @media (max-width: 991px) {
    .bento-grid { grid-template-columns: 1fr 1fr; }
    .bento-card { grid-column: auto !important; min-height: 240px; }
    .b2 { min-height: 300px; }
  }
  @media (max-width: 600px) {
    .bento-grid { grid-template-columns: 1fr; }
    .bento-phone { position: static; margin-top: 24px; }
    .phone { margin-inline: auto; }
  }
</style>
