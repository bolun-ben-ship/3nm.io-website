{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/index", "destination": "/", "permanent": true },
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/case-study-education-consulting", "destination": "/case-studies#education-consulting", "permanent": true },
    { "source": "/case-study-compliance-workflow", "destination": "/case-studies#compliance-workflow", "permanent": true },
    { "source": "/case-study-family-office", "destination": "/case-studies#family-office", "permanent": true },
    { "source": "/case-study-3pl-logistics", "destination": "/case-studies#3pl-logistics", "permanent": true },
    { "source": "/case-study-executive-recruitment", "destination": "/case-studies#executive-recruitment", "permanent": true },
    { "source": "/compliance-workflow-case-study", "destination": "/case-studies#compliance-workflow", "permanent": true },
    { "source": "/about", "destination": "/", "permanent": false },
    { "source": "/how-it-works", "destination": "/", "permanent": false },
    { "source": "/blog", "destination": "/", "permanent": false },
    { "source": "/why-ai-automation-projects-fail", "destination": "/", "permanent": false },
    { "source": "/cost-of-manual-workflows", "destination": "/", "permanent": false },
    { "source": "/operational-visibility-first", "destination": "/", "permanent": false },
    { "source": "/self-improving-system", "destination": "/", "permanent": false },
    { "source": "/what-is-an-ai-operating-system", "destination": "/", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*)\\.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
